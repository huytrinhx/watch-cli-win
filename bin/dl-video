#!/usr/bin/env bash
# dl-video <url> [out-dir]
# Downloads a video from any yt-dlp-supported platform (YouTube, X,
# LinkedIn, TikTok, Reddit, Vimeo, Facebook, …) into a local mp4 and
# prints the absolute path on stdout. Stderr carries progress.
#
# Cookie fallback (4 tiers, tried in order):
#   1. Anonymous fetch — works for all public videos.
#   2. Cookies from a signed-in browser, only when the user opts in with
#      WATCH_BROWSER=auto (Chrome → Firefox → Safari → Edge → Brave →
#      Chromium) or WATCH_BROWSER=<one of those>. Unset or "none": skipped.
#   3. Manual cookies file via --cookies <file> (Netscape format).
#   4. Graceful error with guidance — no silent failure.
#
# Exit codes (see docs/exit-codes.md):
#   0 success · 2 missing-dep · 3 download fail · 64 usage error · 1 other

set -uo pipefail

# Resolve symlinks so $ROOT_DIR points at the real install dir, not ~/.local.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
  SELF="$(readlink "$SELF")"
  [[ $SELF != /* ]] && SELF="$SELF_DIR/$SELF"
done
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
ROOT_DIR="$(cd "$SELF_DIR/.." && pwd)"
# shellcheck source=../lib/version.sh
source "$ROOT_DIR/lib/version.sh"
# shellcheck source=../lib/hash.sh
source "$ROOT_DIR/lib/hash.sh"
# shellcheck source=../lib/dotenv.sh
source "$ROOT_DIR/lib/dotenv.sh"
# shellcheck source=../lib/shell-safety.sh
source "$ROOT_DIR/lib/shell-safety.sh"
watch_cli_warn_if_backgrounded

URL=""
OUTDIR="/tmp/dl-video"
COOKIES_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cookies)
      COOKIES_FILE="$2"
      shift 2
      ;;
    --cookies=*)
      COOKIES_FILE="${1#*=}"
      shift
      ;;
    -h|--help)
      sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -V|--version)
      echo "$WATCH_CLI_VERSION_STRING"
      exit 0
      ;;
    *)
      if [[ -z "$URL" ]]; then
        URL="$1"
      elif [[ "$OUTDIR" == "/tmp/dl-video" ]]; then
        OUTDIR="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$URL" ]]; then
  echo "usage: dl-video <url> [out-dir] [--cookies <file>] tag=usage-error" >&2
  exit 64
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "[dl-video] error: yt-dlp not found on PATH. Install via 'sudo apt install yt-dlp' or 'pipx install yt-dlp'. tag=missing-dep:yt-dlp" >&2
  exit 2
fi

mkdir -p "$OUTDIR"

# Idempotent cache: same URL → same output file.
HASH="$(echo -n "$URL" | watch_hash_sha1_stdin | cut -c1-12)"
OUT="$OUTDIR/$HASH.mp4"
if [[ -s "$OUT" ]]; then
  echo "$OUT"
  exit 0
fi

# Modern YouTube rarely offers a single-file (progressive) format above
# ~360p any more — video and audio are separate streams that need
# merging. A progressive-only selector increasingly resolves to nothing
# at all ("Requested format is not available") once that lone low-res
# fallback is unavailable for a given client/PO-token state. ffmpeg is
# already a hard dependency (checked in bin/watch's dep list), so prefer
# the merge and only fall back to a single muxed file — which is still
# what LinkedIn/Facebook expose, and what to use when ffmpeg is missing
# (dl-video, unlike watch, doesn't require ffmpeg to run standalone).
if command -v ffmpeg >/dev/null 2>&1; then
  FORMAT='bestvideo[height<=720]+bestaudio/best[height<=720]/best'
else
  FORMAT='best[height<=720]/best'
fi

# --write-info-json drops a <hash>.info.json sidecar (title, uploader,
# duration) next to the mp4. It rides along with the download already in
# flight, so naming an archived video later costs no extra request. stdout
# is unchanged: still just the mp4 path.
run_dl() {
  yt-dlp \
    --no-playlist \
    --no-warnings \
    --no-progress \
    --merge-output-format mp4 \
    --write-info-json \
    -f "$FORMAT" \
    -o "$OUT" \
    "$@" \
    "$URL" >&2
}

# WSL2 runs watch-cli as a Linux process, so --cookies-from-browser only
# ever finds a browser profile inside the WSL filesystem — never the
# Windows-native Chrome/Edge/Firefox at /mnt/c/Users/<name>/AppData/...
# the user is actually signed into. WATCH_BROWSER=auto silently finds
# nothing there instead of erring usefully, so the download-auth message
# needs a different fix path on this platform. See docs/cookies.md#windows-wsl2.
_is_wsl() {
  [[ "$(uname -s)" == "Linux" ]] && grep -qi microsoft /proc/version 2>/dev/null
}

# Locate a Windows-native Firefox profile from inside WSL2, so
# WATCH_BROWSER=firefox works against the session the user is actually
# signed into (on Windows) instead of a WSL-local Firefox that almost
# nobody installs separately. Chrome/Edge/Brave can't get the same
# treatment: they encrypt cookies with Windows DPAPI, which nothing on
# the Linux side can decrypt (see docs/cookies.md#windows-wsl2) — Firefox
# stores cookies in a plain SQLite file, so reading it across the /mnt/c
# boundary just works.
#
# Prefers *.default-release (Firefox's profile name since ~2020) and
# falls back to the older *.default. Multiple Windows user accounts each
# get their own /mnt/c/Users/<name>/..., so this can match more than one
# profile; the first hit wins; set WATCH_BROWSER=none and pass a manual
# --cookies file if that's the wrong one.
_find_windows_firefox_profile() {
  local pattern profile
  for pattern in '.default-release' '.default'; do
    profile="$(ls -d /mnt/c/Users/*/AppData/Roaming/Mozilla/Firefox/Profiles/*"$pattern" 2>/dev/null | head -1)"
    [[ -n "$profile" ]] && { printf '%s' "$profile"; return 0; }
  done
  return 1
}

# Classify yt-dlp's last stderr log into one of the documented tags.
# Falls through to download-other when nothing matches.
classify_failure() {
  local log="/tmp/dl-video.last.log"
  [[ -f "$log" ]] || { echo "download-other"; return; }
  local body
  body="$(tr '[:upper:]' '[:lower:]' < "$log")"
  if grep -qE 'sign in|login required|authentication|private|members[- ]only|http error 401|http error 403' <<< "$body"; then
    echo "download-auth"
  elif grep -qE 'geo[- ]restrict|not available in your country|region' <<< "$body"; then
    echo "download-region"
  elif grep -qE 'timed out|timeout|connection reset|temporary failure|network is unreachable|name or service not known|getaddrinfo|tls handshake' <<< "$body"; then
    echo "download-network"
  else
    echo "download-other"
  fi
}

# Tier 1: anonymous. Public videos succeed here.
if run_dl 2>/tmp/dl-video.last.log; then
  if [[ -s "$OUT" ]]; then
    echo "$OUT"
    exit 0
  fi
fi

# Tier 3: caller passed --cookies file. Skip browser autodetect.
if [[ -n "$COOKIES_FILE" ]]; then
  echo "[dl-video] anonymous fetch failed, retrying with $COOKIES_FILE…" >&2
  if [[ ! -f "$COOKIES_FILE" ]]; then
    echo "[dl-video] error: cookies file not found: $COOKIES_FILE tag=usage-error" >&2
    exit 64
  fi
  if run_dl --cookies "$COOKIES_FILE" 2>/tmp/dl-video.last.log; then
    if [[ -s "$OUT" ]]; then
      echo "$OUT"
      exit 0
    fi
  fi
  TAG="$(classify_failure)"
  echo "[dl-video] error: download failed for $URL even with provided cookies tag=$TAG" >&2
  exit 3
fi

# Tier 2: cookies from a signed-in browser, opt-in only. A browser
# session is the user's identity on that platform, so watch-cli never
# reads one unless asked: WATCH_BROWSER=auto tries Chrome → Firefox →
# Safari → Edge → Brave → Chromium, WATCH_BROWSER=firefox tries that
# one. Unset (the default) or "none" skips this tier, and a login wall
# fails with tag=download-auth and a hint instead.
declare -a BROWSERS
case "${WATCH_BROWSER:-}" in
  ""|none) BROWSERS=() ;;
  auto) BROWSERS=(chrome firefox safari edge brave chromium) ;;
  *) BROWSERS=("$WATCH_BROWSER") ;;
esac

# Tracked so the Tier 4 message below can tell the difference between
# "never tried a Windows Firefox profile" and "tried it, still failed".
WIN_FF_PROFILE=""

# ${arr[@]+"${arr[@]}"} keeps `set -u` happy on an empty array (bash 3.2).
for BROWSER in ${BROWSERS[@]+"${BROWSERS[@]}"}; do
  # On WSL2, "firefox" alone points yt-dlp at a WSL-local Firefox profile
  # that almost never exists. Try the Windows-native profile first — the
  # one the user is actually signed into — before falling through to the
  # (expected-to-fail) plain attempt.
  if [[ "$BROWSER" == "firefox" ]] && _is_wsl; then
    WIN_FF_PROFILE="$(_find_windows_firefox_profile || true)"
    if [[ -n "$WIN_FF_PROFILE" ]]; then
      echo "[dl-video] anonymous fetch failed, retrying with your Windows Firefox cookies ($WIN_FF_PROFILE)…" >&2
      if run_dl --cookies-from-browser "firefox:$WIN_FF_PROFILE" 2>/tmp/dl-video.last.log; then
        if [[ -s "$OUT" ]]; then
          echo "$OUT"
          exit 0
        fi
      fi
      continue
    fi
  fi
  echo "[dl-video] anonymous fetch failed, retrying with $BROWSER cookies…" >&2
  if run_dl --cookies-from-browser "$BROWSER" 2>/tmp/dl-video.last.log; then
    if [[ -s "$OUT" ]]; then
      echo "$OUT"
      exit 0
    fi
  fi
done

# Tier 4: classify the final failure and emit a tag-tagged stderr line.
#
# The auth/region/network messages below are diagnosed from the log, but
# "download-other" has no specific guidance to give — the log itself
# *is* the diagnosis. Every tag benefits from seeing it, so print it
# once here rather than claiming it's "above" when it was actually only
# ever captured into /tmp/dl-video.last.log and never shown.
LAST_LOG="/tmp/dl-video.last.log"
if [[ -s "$LAST_LOG" ]]; then
  echo "[dl-video] yt-dlp output ($LAST_LOG):" >&2
  sed 's/^/  /' "$LAST_LOG" >&2
fi

TAG="$(classify_failure)"
case "$TAG" in
  download-auth)
    if _is_wsl && [[ -n "$WIN_FF_PROFILE" ]]; then
      # We DID find and try a Windows-native Firefox profile automatically
      # — cookies alone didn't fix it, so re-suggesting the same cookies
      # dance would be useless noise. Point at the more likely causes.
      cat >&2 <<ERR
[dl-video] error: download failed for $URL tag=download-auth — already tried your Windows Firefox cookies ($WIN_FF_PROFILE), still blocked

Things to check:
  1. Are you actually signed in to the platform in that Windows Firefox
     profile? Open Firefox on Windows, sign in, then retry.
  2. Close Firefox before retrying — an open Firefox holds a lock on its
     cookie database that can make the read fail or return stale cookies.
  3. If you use a different Firefox profile, or multiple Windows user
     accounts, the wrong one may have been picked automatically. Pass
     --cookies <file> with a manually exported cookies.txt instead:
     https://github.com/huytrinhx/watch-cli-win/blob/main/docs/cookies.md#windows-wsl2
  4. This may not be a cookies problem at all — some videos are
     region-locked or blocked by YouTube's bot-check independent of
     sign-in state. Try a different public URL to sanity-check the setup.
ERR
    elif _is_wsl; then
      cat >&2 <<ERR
[dl-video] error: download failed for $URL tag=download-auth — WATCH_BROWSER can't reach your Windows browser under WSL2, see below

Two ways to fix:
  1. Recommended: sign in to the platform in Firefox on Windows, then
     re-run with
       WATCH_BROWSER=firefox watch <url>
     watch-cli auto-detects your Windows Firefox profile under
     /mnt/c/Users/*/AppData/Roaming/Mozilla/Firefox/Profiles/ and reads
     its cookies directly — no manual export needed. (Chrome/Edge/Brave
     can't get the same treatment: they encrypt cookies with Windows
     DPAPI, which nothing on the Linux side can decrypt.)

  2. Any browser: export cookies.txt with a browser extension instead,
     save it somewhere WSL can read (e.g. /mnt/c/Users/<you>/Downloads/),
     then:
       watch-cli <url> --cookies /mnt/c/Users/<you>/Downloads/cookies.txt
     See https://github.com/huytrinhx/watch-cli-win/blob/main/docs/cookies.md#windows-wsl2

  3. Try a public URL — most YouTube, TikTok, and Reddit videos
     work without cookies.
ERR
    else
      cat >&2 <<ERR
[dl-video] error: download failed for $URL tag=download-auth — re-run with WATCH_BROWSER=auto to use a signed-in browser on this machine, or pass --cookies <file>

Three ways to fix:
  1. Sign in to the platform in Chrome (or Firefox/Safari/Edge), then re-run with
       WATCH_BROWSER=auto watch <url>
     Cookies are read from the local browser profile and sent only to that
     platform. watch-cli never does this unless you set WATCH_BROWSER.

  2. Export cookies.txt (Netscape format) and pass:
       watch-cli <url> --cookies ~/path/to/cookies.txt
     See https://github.com/huytrinhx/watch-cli-win/blob/main/docs/cookies.md

  3. Try a public URL — most YouTube, TikTok, and Reddit videos
     work without cookies.
ERR
    fi
    ;;
  download-region)
    echo "[dl-video] error: download failed for $URL tag=download-region — video is geo-restricted, try a VPN in the supported region" >&2
    ;;
  download-network)
    echo "[dl-video] error: download failed for $URL tag=download-network — transient network failure, wait and retry" >&2
    ;;
  *)
    echo "[dl-video] error: download failed for $URL tag=download-other — see yt-dlp output above for details" >&2
    ;;
esac
exit 3
